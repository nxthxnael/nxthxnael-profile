# Paystack — required to enable checkout on /services
# Get a test secret key from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_...

# Optional — posts a notification to a Discord channel when a payment
# succeeds, via the /api/webhooks/paystack route. Create one under
# Channel Settings > Integrations > Webhooks in Discord.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
